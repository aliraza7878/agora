# AGORA backend configuration. Copy to .env (never commit .env).
# By default NO provider key is configured: every user pastes their own Groq key in the app,
# and it is sent per request in the X-Provider-Key header (never stored or logged).

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

# OpenAI-compatible provider endpoint (Groq by default)
LLM_BASE_URL=https://api.groq.com/openai/v1

# OPTIONAL hosted-demo fallback. Leave false for bring-your-own-key only.
ALLOW_SERVER_KEY=false
# GROQ_API_KEY=   # only read when ALLOW_SERVER_KEY=true

# Max accepted request body in bytes
MAX_BODY_BYTES=262144
